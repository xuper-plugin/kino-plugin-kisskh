{
  "id": "kisskh",
  "name": "KissKH",
  "version": "0.1.0",
  "apiVersion": 25,
  "panel": {
    "label": "KissKH",
    "labelEn": "KissKH",
    "iconFile": "panel-icon.png"
  },
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Doramas, series y películas asiáticas, y anime, con subtítulos en varios idiomas",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-kisskh",
  "hosts": [
    "kisskh.do",
    "load.kisskh.co",
    "media.themoviedb.org",
    "image.tmdb.org",
    "serveproxy.com",
    "fragrancecdn1.site",
    "*.nflxso.net",
    "*.wetvinfo.com"
  ],
  "fetchHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "scopedSearch",
    "download",
    "screen"
  ],
  "streamHosts": "any",
  "categories": [
    "movies",
    "series"
  ],
  "color": "#E91E63",
  "theme": {
    "accent": "#E0245E",
    "onAccent": "#FFFFFF",
    "background": "#0D0709",
    "surface": "#1B1115",
    "highlight": "#F8C4D4"
  },
  "browser": true,
  "telemetry": true,
  "settings": [
    {
      "key": "langSection",
      "type": "section",
      "label": "Idioma y subtítulos",
      "labelEn": "Language and subtitles"
    },
    {
      "key": "preferredSubLang",
      "type": "select",
      "label": "Idioma de subtítulos",
      "labelEn": "Subtitle language",
      "default": "en",
      "options": [
        {
          "value": "en",
          "label": "Inglés",
          "labelEn": "English"
        },
        {
          "value": "es",
          "label": "Español",
          "labelEn": "Spanish"
        }
      ],
      "hint": "El subtítulo que se activa primero cuando hay varios.",
      "hintEn": "The subtitle switched on first when there are several."
    },
    {
      "key": "playSection",
      "type": "section",
      "label": "Reproducción",
      "labelEn": "Playback"
    },
    {
      "key": "maxQuality",
      "type": "select",
      "label": "Calidad máxima",
      "labelEn": "Maximum quality",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automática",
          "labelEn": "Automatic"
        },
        {
          "value": "1080p",
          "label": "Hasta 1080p",
          "labelEn": "Up to 1080p"
        },
        {
          "value": "720p",
          "label": "Hasta 720p",
          "labelEn": "Up to 720p"
        },
        {
          "value": "480p",
          "label": "Hasta 480p (ahorra datos)",
          "labelEn": "Up to 480p (saves data)"
        }
      ]
    },
    {
      "key": "forceBrowserLane",
      "type": "toggle",
      "label": "Reproducir siempre con el navegador",
      "labelEn": "Always play through the browser",
      "default": false,
      "hint": "Actívalo solo si los capítulos no abren de la forma normal.",
      "hintEn": "Turn it on only if episodes do not open the normal way."
    },
    {
      "key": "homeSection",
      "type": "section",
      "label": "Inicio",
      "labelEn": "Home"
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "labelEn": "Rows on Home",
      "default": true,
      "hint": "Muestra las novedades de KissKH en el Inicio de Kino.",
      "hintEn": "Shows KissKH's new releases on Kino's Home."
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Estado",
      "labelEn": "Status",
      "hint": "Dice si el catálogo y la reproducción respondieron en la última prueba.",
      "hintEn": "Says whether the catalogue and playback answered on the last test."
    },
    {
      "key": "health",
      "type": "status",
      "label": "KissKH",
      "labelEn": "KissKH"
    },
    {
      "key": "probe",
      "type": "action",
      "label": "Probar ahora",
      "labelEn": "Test now"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Borrar caché",
      "labelEn": "Clear cache"
    },
    {
      "key": "resetPrefs",
      "type": "action",
      "label": "Restablecer preferencias",
      "labelEn": "Reset preferences",
      "confirm": "¿Volver a los valores de fábrica de KissKH?",
      "confirmEn": "Go back to KissKH's default settings?"
    }
  ],
  "screen": {
    "label": "KissKH",
    "labelEn": "KissKH",
    "iconFile": "panel-icon.png",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsIn": "settings"
  }
}
